{
  "version": 1,
  "kernel": {
    "name": "SoftmaxStable",
    "lean": "VeriTile.Bench.Examples.SoftmaxStable.Kernels.stableSoftmaxKernel",
    "source": "bench/examples/SoftmaxStable/SoftmaxStable.py::stable_softmax"
  },
  "grid": [
    2
  ],
  "launch": {
