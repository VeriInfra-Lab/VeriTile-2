      },
      "expected": {
        "yReg": "tests/interp/fixtures/tensor_examples/SoftmaxStable-output.tensor"
      }
    }
  ],
  "output_buffers": [
    {
      "name": "yReg",
      "dtype": "bf16",
      "shape": [
        2,
        4
      ]
    }
  ]
}
