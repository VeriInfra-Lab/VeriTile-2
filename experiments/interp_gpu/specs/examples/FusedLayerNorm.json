{
  "version": 1,
  "kernel": {
    "name": "FusedLayerNorm",
    "lean": "VeriTile.Bench.Examples.FusedLayerNorm.Kernels.fusedLayerNormKernel",
    "source": "bench/examples/FusedLayerNorm/FusedLayerNorm.py::fusedLayerNormKernel"
  },
  "grid": [
    2
  ],
  "launch": {
    "carrier": "binary64"
  },
  "constexpr": {
    "N": 4,
    "ε": 0.125
  },
  "arguments": [
    {
      "parameter": "xReg",
      "buffer": "xReg"
    },
    {
      "parameter": "γReg",
      "buffer": "γReg"
    },
    {
      "parameter": "βReg",
      "buffer": "βReg"
    },
    {
      "parameter": "yReg",
      "buffer": "yReg"
    },
    {
      "parameter": "rowStride",
      "value": 5
    }
  ],
  "input_classes": [
    {
      "class": "normal",
      "inputs": {
        "xReg": {
          "dtype": "fp32",
          "shape": [
            2,
            5
          ],
          "file": "tests/interp/fixtures/tensor_examples/norm-padded.tensor"
        },
        "γReg": {
          "dtype": "fp32",
          "shape": [
            4
          ],
          "file": "tests/interp/fixtures/tensor_examples/norm-scale.tensor"
        },
        "βReg": {
          "dtype": "fp32",
          "shape": [
            4
          ],
          "file": "tests/interp/fixtures/tensor_examples/norm-bias.tensor"
        }
      },
      "expected": {
        "yReg": "tests/interp/fixtures/tensor_examples/norm-output.tensor"
      }
    }
  ],
  "output_buffers": [
    {
      "name": "yReg",
      "dtype": "bf16",
      "shape": [
        2,
        4
      ]
    }
  ]
}
