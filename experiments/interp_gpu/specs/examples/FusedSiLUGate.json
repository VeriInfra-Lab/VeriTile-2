        "gateReg": {
          "dtype": "fp64",
          "shape": [
            4
          ],
          "file": "tests/interp/fixtures/tensor_examples/silu-gateReg.tensor"
        }
      },
      "expected": {
        "zReg": "tests/interp/fixtures/tensor_examples/silu-zReg.tensor"
      }
    }
  ],
  "output_buffers": [
    {
      "name": "zReg",
      "dtype": "fp64",
      "shape": [
        4
      ]
    }
  ]
}
