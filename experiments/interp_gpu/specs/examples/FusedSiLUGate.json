{
  "version": 1,
  "kernel": {
    "name": "FusedSiLUGate",
    "lean": "VeriTile.Bench.Examples.FusedSiLU.Kernels.siluStepGateKernel",
    "source": "bench/examples/FusedSiLU/FusedSiLU.py::silu_gate"
  },
  "grid": [
    2
  ],
  "launch": {
    "carrier": "binary64"
  },
  "constexpr": {
