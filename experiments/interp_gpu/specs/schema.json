{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VeriTile interpreter benchmark launch",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kernel", "grid", "launch", "constexpr", "arguments", "input_classes", "output_buffers"],
  "properties": {
    "version": {"const": 1},
    "kernel": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "lean", "source"],
      "properties": {
        "name": {"$ref": "#/definitions/name", "description": "Registry name passed to veritile-run."},
        "lean": {"type": "string", "minLength": 1, "description": "Qualified Lean source definition."},
        "source": {"type": "string", "pattern": "^[^:]+\\.py::[^:]+$", "description": "Repository-relative Python path::function."}
      }
    },
    "grid": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "integer", "minimum": 0}},
    "launch": {
      "type": "object", "additionalProperties": false, "required": ["carrier"],
      "properties": {
        "carrier": {"$ref": "#/definitions/name"},
        "num_warps": {"type": "integer", "minimum": 1},
        "num_stages": {"type": "integer", "minimum": 1},
        "enable_fp_fusion": {"type": "boolean"}
      },
      "description": "carrier selects the interpreter implementation. The optional parameters configure a corresponding Triton launch."
    },
    "constexpr": {
      "type": "object", "propertyNames": {"$ref": "#/definitions/name"},
      "additionalProperties": {"$ref": "#/definitions/scalar"},
      "description": "Source constexpr parameters specialized for this grid and these tensors."
    },
    "arguments": {
      "type": "array", "minItems": 1,
      "description": "Runtime arguments in Python signature order, omitting constexpr parameters. Buffer names are shared with the input cases and outputs.",
      "items": {"oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["parameter", "buffer"],
         "properties": {"parameter": {"$ref": "#/definitions/name"}, "buffer": {"$ref": "#/definitions/name"}}},
        {"type": "object", "additionalProperties": false, "required": ["parameter", "value"],
         "properties": {"parameter": {"$ref": "#/definitions/name"}, "value": {"$ref": "#/definitions/scalar"}}}
      ]}
    },
    "input_classes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["class", "inputs", "expected"],
        "properties": {
          "class": {"enum": ["normal", "boundary", "special"]},
          "inputs": {"type": "object", "propertyNames": {"$ref": "#/definitions/name"}, "additionalProperties": {"$ref": "#/definitions/fileTensor"}},
          "expected": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/definitions/name"},
            "additionalProperties": {"type": "string", "minLength": 1}, "description": "One independent version-1 tensor fixture per output, with paths relative to the repository root."}
        }
      }
    },
    "output_buffers": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["name", "dtype", "shape"],
        "properties": {"name": {"$ref": "#/definitions/name"}, "dtype": {"$ref": "#/definitions/dtype"}, "shape": {"$ref": "#/definitions/shape"}}}
    }
  },
  "definitions": {
    "name": {"type": "string", "minLength": 1},
    "scalar": {"type": ["number", "boolean", "string"]},
    "dtype": {"enum": ["fp32", "fp16", "bf16", "fp64", "f8e4", "f8e5", "int8", "int16", "int32", "int64", "uint8", "uint16", "uint32", "uint64", "bool"]},
    "shape": {"type": "array", "maxItems": 8, "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}},
    "fileTensor": {"type": "object", "additionalProperties": false, "required": ["dtype", "shape", "file"],
      "properties": {"dtype": {"$ref": "#/definitions/dtype"}, "shape": {"$ref": "#/definitions/shape"}, "file": {"type": "string", "minLength": 1}}}
  }
}
